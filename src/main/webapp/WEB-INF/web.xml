<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
    
    <!-- SERVLET: HOME -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.pa1poo.Controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
    <servlet-name>HomeController</servlet-name>
    <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
    <!-- SERVLET: TEATRO -->
    <servlet>
        <servlet-name>TeatroController</servlet-name>
        <servlet-class>com.pa1poo.Controller.TeatroController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TeatroController</servlet-name>
        <url-pattern>/teatro</url-pattern>
    </servlet-mapping>

    <!-- SERVLET: CONVERSIÓN -->
    <servlet>
        <servlet-name>ConversionController</servlet-name>
        <servlet-class>com.pa1poo.Controller.ConversionController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConversionController</servlet-name>
        <url-pattern>/conversion</url-pattern>
    </servlet-mapping>

    <!-- SERVLET: FIGURA -->
    <servlet>
        <servlet-name>FiguraController</servlet-name>
        <servlet-class>com.pa1poo.Controller.FiguraController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FiguraController</servlet-name>
        <url-pattern>/figuras</url-pattern>
    </servlet-mapping>

    <!-- SERVLET: ROMANOS -->
    <servlet>
        <servlet-name>RomanosController</servlet-name>
        <servlet-class>com.pa1poo.Controller.RomanosController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RomanosController</servlet-name>
        <url-pattern>/romanos</url-pattern>
    </servlet-mapping>

    <!-- SERVLET: TRAPECIO -->
    <servlet>
        <servlet-name>TrapecioController</servlet-name>
        <servlet-class>com.pa1poo.Controller.TrapecioController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrapecioController</servlet-name>
        <url-pattern>/trapecios</url-pattern>
    </servlet-mapping>

    <!-- WELCOME FILE -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>